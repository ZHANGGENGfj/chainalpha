# ChainAlpha LLM provider.
# Supported values:
# - deepseek: use DeepSeek OpenAI-compatible API.
# - openai: use OPENAI_* settings. Also works for DashScope/vLLM/Ollama compatible endpoints.
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Generic OpenAI-compatible fallback.
# Keep these for OpenAI, DashScope compatible mode, local vLLM, Ollama, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Real-time financial event collection.
# The collector runs once at API startup, then waits at least 120 seconds
# after each completed run. Existing MediaCrawler and event-store dedup rules
# prevent duplicate news from being inserted again.
EVENT_AUTO_COLLECT=true
EVENT_COLLECT_INTERVAL_SECONDS=120
EVENT_COLLECT_TIMEOUT_SECONDS=600
# Empty means each source's latest-news page, which is the recommended
# real-time dashboard mode. Set comma-separated terms for targeted collection.
EVENT_COLLECT_KEYWORDS=
MEDIA_CRAWLER_ROOT=third_party/MediaCrawler-main
# Leave empty to use the Python interpreter that starts Uvicorn.
MEDIA_CRAWLER_PYTHON=

# AI analysis for the deduplicated real-time event stream. Analysis runs after
# each collection cycle, only for new/changed events, and reuses a local cache.
EVENT_LLM_ANALYSIS=true
EVENT_LLM_BATCH_SIZE=5
EVENT_LLM_MAX_EVENTS_PER_RUN=20
EVENT_LLM_MIN_IMPORTANCE=35
EVENT_LLM_TIMEOUT_SECONDS=90
EVENT_LLM_CACHE_PATH=data/event_store/llm_analysis.json

# Five Good stock pools. When no store file exists, demo mode is clearly
# labelled in the UI. Set false in production until real screening data lands.
FIVE_GOOD_DEMO_DATA=true
FIVE_GOOD_STORE_PATH=data/five_good/store.json
# Full-market Five Good screening. Keep credentials only in .env.
TUSHARE_TOKEN=
# Optional compatible/private Tushare endpoint; empty uses the official endpoint.
TUSHARE_BASE_URL=
FIVE_GOOD_POOL_SIZE=80
FIVE_GOOD_MIN_SCORE=60
FIVE_GOOD_MIN_COMPLETENESS=0.60
# Keep false in normal use: event evidence is attached by the background screener.
FIVE_GOOD_LIVE_EVENT_HYDRATION=false

# Optional independent model for benchmark judging. If omitted, the regular
# LLM configuration is reused.
BENCHMARK_JUDGE_PROVIDER=deepseek
BENCHMARK_JUDGE_API_KEY=
BENCHMARK_JUDGE_BASE_URL=https://api.deepseek.com
BENCHMARK_JUDGE_MODEL=deepseek-chat

# Runtime financial Skills, resumable Agent state, tool outcome learning and
# point-in-time evidence memory. These settings are shared by CLI and web runs.
CHAINALPHA_SKILL_ROOT=skills
CHAINALPHA_AGENT_STATE_DIR=data/agent_states
CHAINALPHA_TOOL_PERFORMANCE_PATH=data/agent/tool_performance.json
CHAINALPHA_EVIDENCE_MEMORY_PATH=data/research_memory/evidence.sqlite3

# Invite-only local account system. No SMS provider or third-party identity
# service is required. Change both values before exposing the site publicly.
AUTH_ENABLED=true
AUTH_SECRET=replace_with_a_long_random_secret
AUTH_DATABASE_PATH=data/auth/chainalpha_auth.sqlite3
AUTH_BOOTSTRAP_INVITE=replace_with_your_first_invite_code
AUTH_BOOTSTRAP_INVITE_MAX_USES=10
AUTH_SESSION_DAYS=7
# Set true only when the site is served through HTTPS.
AUTH_COOKIE_SECURE=false
