# ChainAlpha LLM provider.
# Supported values:
# - deepseek: use DeepSeek OpenAI-compatible API.
# - openai: use OPENAI_* settings. Also works for DashScope/vLLM/Ollama compatible endpoints.
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=sk-91dea347270045368efcf3a49eca6a91
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Generic OpenAI-compatible fallback.
# Keep these for OpenAI, DashScope compatible mode, local vLLM, Ollama, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
